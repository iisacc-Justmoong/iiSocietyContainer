<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleIdentifier</key><string>@SOCIETY_IOS_PROVIDER_IDENTIFIER@</string>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleName</key><string>Society Container</string>
    <key>CFBundleDisplayName</key><string>Society Container</string>
    <key>CFBundlePackageType</key><string>XPC!</string>
    <key>CFBundleVersion</key><string>@SOCIETY_IOS_VERSION@</string>
    <key>CFBundleShortVersionString</key><string>@SOCIETY_IOS_VERSION@</string>
    <key>MinimumOSVersion</key><string>@SOCIETY_IOS_MINIMUM@</string>
    <key>SocietyAppGroup</key><string>@SOCIETY_IOS_GROUP@</string>
    <key>NSExtension</key><dict>
        <key>NSExtensionPointIdentifier</key><string>com.apple.fileprovider-nonui</string>
        <key>NSExtensionPrincipalClass</key><string>SocietyContainerFileProvider</string>
        <key>NSExtensionFileProviderSupportsEnumeration</key><true/>
        <key>NSExtensionFileProviderDocumentGroup</key><string>@SOCIETY_IOS_GROUP@</string>
    </dict>
</dict></plist>
