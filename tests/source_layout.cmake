if(NOT SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
if(EXISTS "${SOURCE_ROOT}/src/iiSocietyContainer")
    message(FATAL_ERROR "The source tree must not repeat the project name")
endif()
foreach(_name DashboardFiles PreviewCache SocietyApplication)
    foreach(_extension h cpp)
        if(NOT EXISTS "${SOURCE_ROOT}/src/Gui/${_name}.${_extension}")
            message(FATAL_ERROR "GUI interface and implementation must be adjacent: ${_name}.${_extension}")
        endif()
    endforeach()
endforeach()
