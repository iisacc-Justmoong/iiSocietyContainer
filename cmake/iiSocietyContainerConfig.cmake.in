@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT iiSocietyContainer_FIND_COMPONENTS STREQUAL "FileTree")
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core)
endif()
set(iiSocietyContainer_FileTree_FOUND TRUE)
if("Gui" IN_LIST iiSocietyContainer_FIND_COMPONENTS)
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Gui Concurrent Quick)
    set(iiSocietyContainer_Gui_FOUND @IISOCIETYCONTAINER_BUILD_GUI@)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiSocietyContainerTargets.cmake")
if(@IISOCIETYCONTAINER_HAS_DESKTOP_MOUNT@)
    set_and_check(iiSocietyContainer_MOUNT_EXECUTABLE "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/iiSocietyContainerMount@CMAKE_EXECUTABLE_SUFFIX@")
endif()
if(APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set_and_check(iiSocietyContainer_NATIVE_APP "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/iiSocietyContainer/Society.app")
endif()
include("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/iiSocietyContainer/platform/ios/iiSocietyContainerIOS.cmake")
include("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/iiSocietyContainer/platform/android/iiSocietyContainerAndroid.cmake")
check_required_components(iiSocietyContainer)
